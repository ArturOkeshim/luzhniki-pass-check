[Unit]
Description=Luzhniki parking subscription checker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=luzhniki-pass
Group=luzhniki-pass
WorkingDirectory=/opt/luzhniki-pass-check/app
EnvironmentFile=/etc/luzhniki-pass-check.env
Environment=NODE_ENV=production
Environment=SITES_RUNTIME_ROOT=/opt/luzhniki-pass-check/app/.sites-runtime
ExecStart=/opt/luzhniki-pass-check/app/deploy/start.sh
Restart=on-failure
RestartSec=3
TimeoutStartSec=180
TimeoutStopSec=30
KillMode=control-group
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/opt/luzhniki-pass-check/app/.sites-runtime

[Install]
WantedBy=multi-user.target

