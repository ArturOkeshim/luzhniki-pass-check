B24_WEBHOOK_URL=https://crm.luzhniki.ru/rest/USER_ID/WEBHOOK_TOKEN/
B24_PORTAL_HOST=crm.luzhniki.ru
B24_SUBSCRIPTION_CATEGORY_ID=40
B24_SUBSCRIPTION_PAID_STAGE_ID=C40:WON
B24_EXCLUDED_PRODUCT_IDS=4768
B24_SUBSCRIPTION_DURATION_DAYS=30

# Отдельные аккаунты сервиса. Каждый пароль — не короче 12 символов.
# Поддерживаются SERVICE_AUTH_LOGIN_1…20 и SERVICE_AUTH_PASSWORD_1…20.
SERVICE_AUTH_LOGIN_1=guard01
SERVICE_AUTH_PASSWORD_1=change-to-a-long-password-01
SERVICE_AUTH_LOGIN_2=guard02
SERVICE_AUTH_PASSWORD_2=change-to-a-long-password-02
SERVICE_AUTH_LOGIN_3=guard03
SERVICE_AUTH_PASSWORD_3=change-to-a-long-password-03
SERVICE_AUTH_LOGIN_4=guard04
SERVICE_AUTH_PASSWORD_4=change-to-a-long-password-04
SERVICE_AUTH_LOGIN_5=guard05
SERVICE_AUTH_PASSWORD_5=change-to-a-long-password-05
# Случайная строка не короче 32 символов.
SERVICE_SESSION_SECRET=change-to-a-random-secret-at-least-32-characters

# Обязательный read-only шлюз на сервере Bitrix. Токен хранится только
# на серверной стороне и не передаётся в браузер.
RECEIVER_GATEWAY_URL=https://crm.luzhniki.ru/parking-receiver-check/api.php
RECEIVER_GATEWAY_HOST=crm.luzhniki.ru
RECEIVER_GATEWAY_TOKEN=change-to-the-gateway-token
RECEIVER_CACHE_TTL_SECONDS=30

# Прямое API приёмника — только запасной вариант для размещения внутри сети.
RECEIVER_API_URL=http://10.182.65.12:8181/
RECEIVER_API_HOSTS=10.182.65.12
RECEIVER_API_USER=receiver_api_user
RECEIVER_API_PASSWORD=receiver_api_password
RECEIVER_API_PAUSE_MS=3000
RECEIVER_API_MAX_PAGES=100
# Для локального запуска вместо прямых реквизитов можно использовать
# безопасный локальный интерфейс Skidata из соседнего проекта.
# RECEIVER_SIDECAR_URL=http://127.0.0.1:8765/api/state
